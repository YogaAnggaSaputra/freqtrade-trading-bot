# Freqtrade Environment Variables
# Copy file ini ke .env dan isi dengan nilai Anda

# Binance Futures
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Database
DB_PASSWORD=your_db_password
DB_HOST=postgres
DB_USER=botbinance
DB_NAME=botbinance

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# Trading Config
TRADE_MODE=dry  # atau 'live'
STAKE_AMOUNT=1.0
STAKE_CURRENCY=USDT

# Roadmap engines
QUANT_ENGINE_URL=http://quant-engine:8000
SENTIMENT_ENGINE_URL=http://sentiment-engine:8000
QUANT_ENGINE_ENABLED=true
QUANT_FACTOR_SCORE_ENABLED=false
SENTIMENT_ENGINE_ENABLED=false
ON_CHAIN_ENGINE_URL=http://on-chain-engine:8000
ON_CHAIN_ENGINE_ENABLED=false
ONCHAIN_DATA_PROVIDER_URL=
ONCHAIN_DATA_PROVIDER_API_KEY=
TICK_RECORDER_ENABLED=false
TICK_SYMBOLS=btcusdt,ethusdt
BINANCE_WS_URL=wss://fstream.binance.com
CRYPTOPANIC_API_KEY=your_key_here
TELEGRAM_SENTIMENT_BOT_TOKEN=
TELEGRAM_SENTIMENT_CHANNELS=
TELEGRAM_SENTIMENT_MAX_MESSAGES=50
QUANT_DEFAULT_RISK_PCT=0.01
ORDERBOOK_GATE_ENABLED=false
ORDERBOOK_INTELLIGENCE_ENABLED=false
ORDERBOOK_SPOOFING_MAX=0.70
ORDERBOOK_GATE_MIN_IMBALANCE=0.08
ANOMALY_DETECTION_URL=http://anomaly-detection:8000
ANOMALY_AUTO_PAUSE=true
EXECUTION_AUTO_PAUSE=false
DEAD_MAN_ENABLED=false
DEAD_MAN_SYMBOL=BTCUSDT
DEAD_MAN_TIMEOUT_SECONDS=1800
ADAPTIVE_WHITELIST_URL=http://adaptive-whitelist:8000
ADAPTIVE_WHITELIST_ENABLED=false
WHITELIST_REGIME=
EXIT_CONSENSUS_ENABLED=false
EXIT_CONSENSUS_THRESHOLD=0.65
EXECUTION_GUARD_URL=http://execution-guard:8000
EXECUTION_GUARD_ENABLED=false
BINANCE_WEIGHT_LIMIT=1100
EXECUTION_QUALITY_URL=http://execution-quality:8000
CAPITAL_ALLOCATION_ENABLED=false
CAPITAL_ALLOCATION_URL=http://capital-allocation:8000
PERFORMANCE_ATTRIBUTION_URL=http://performance-attribution:8000
POSITION_MONITOR_URL=http://position-monitor:8000
POSITION_MONITOR_ENABLED=false
POSITION_ADJUSTMENT_ENABLE=false
POSITION_RISK_ENABLED=false
NEWS_ALPHA_URL=http://news-alpha:8000
NEWS_ALPHA_ENABLED=false
NEWS_LLM_ENABLED=false
NEWS_LLM_URL=http://ollama:11434/api/generate
NEWS_LLM_MODEL=qwen2.5:1.5b
NEWS_LLM_TIMEOUT_SECONDS=2.5
AUTO_RETRAIN_ENABLED=false
CHALLENGER_SHADOW_HOURS=48
CHALLENGER_MIN_SHADOW_SAMPLES=100
AUTO_PROMOTE_CHALLENGER=false
CHALLENGER_MIN_ACCURACY=0.55
CHALLENGER_MIN_IMPROVEMENT=0.01
POST_EXIT_REGRET_URL=http://post-exit-regret:8000
REGRET_WORKER_INTERVAL_SECONDS=300
NEWS_HEADLINE=
KILL_SWITCH_CLOSE_POSITIONS=false
TELEGRAM_CONTROL_ENABLED=false
KILL_SWITCH_PIN=replace_with_operator_pin
ORDERBOOK_INTELLIGENCE_URL=http://orderbook-intelligence:8000
PREDICTIVE_LAYER_URL=http://predictive-layer:8000
